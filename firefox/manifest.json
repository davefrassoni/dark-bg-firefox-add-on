{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "1.4.0",
  "default_locale": "en",
  "permissions": [
    "menus",
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "transition-policy.js",
      "settings.js",
      "color.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Dark Background Anti-Flash",
    "default_area": "navbar",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "transition-policy.js",
        "settings.js",
        "color.js",
        "content/content-script.js"
      ],
      "run_at": "document_start",
      "match_about_blank": true
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dark-background-anti-flash@local",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "140.0"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "commands": {
    "toggle-guard": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "__MSG_cmdToggleGuard__"
    },
    "toggle-site": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_cmdToggleSite__"
    },
    "brightness-up": {
      "suggested_key": {
        "default": "Alt+Shift+Up"
      },
      "description": "__MSG_cmdBrightnessUp__"
    },
    "brightness-down": {
      "suggested_key": {
        "default": "Alt+Shift+Down"
      },
      "description": "__MSG_cmdBrightnessDown__"
    }
  }
}
